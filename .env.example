# Database (PostgreSQL)
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]

# Kunci enkripsi cookie session, minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Email via Resend (https://resend.com). Kosongkan saat development:
# isi email dicetak di terminal.
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp via Fonnte (https://fonnte.com). Token ada di menu Device.
# Opsional; kosongkan saat development: pesan hanya ditampilkan di terminal.
FONNTE_TOKEN=

# Zona waktu aplikasi: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta

# Penyimpanan file: Cloudflare R2 (bucket PRIVAT, jangan aktifkan akses publik).
# 1. Cloudflare Dashboard → R2 → Create bucket.
# 2. R2 → Manage API tokens → Create API token, izin "Object Read & Write",
#    batasi ke bucket di atas. Salin Access Key ID & Secret Access Key.
# 3. Account ID ada di halaman R2 (kanan atas).
# Kosongkan keempatnya saat development: file disimpan di folder .storage/ (tidak ikut git).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Kunci endpoint pembersihan harian /api/cron/cleanup (minimal 16 karakter).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# - Vercel: jadwal ada di vercel.json (02.00 WIB); Vercel mengirim header Authorization otomatis.
# - Hosting lain: panggil setiap hari dengan crontab, misal:
#   0 19 * * * curl -s -H "Authorization: Bearer <CRON_SECRET>" https://domain-anda/api/cron/cleanup
# Uji manual saat dev:
#   curl -H "Authorization: Bearer <CRON_SECRET>" http://localhost:3000/api/cron/cleanup
CRON_SECRET=

# Alamat aplikasi (untuk link di email).
NEXT_PUBLIC_APP_URL=http://localhost:3000
